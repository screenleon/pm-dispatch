{
  "title": "Event",
  "description": "Append-only audit event. Records state changes / hook firings / decisions across the PM substrate. CLI-agnostic: `actor` is a free string namespaced by prefix; no CLI product name appears in the `kind` enum.",
  "type": "object",
  "required": ["id", "schema_version", "ts", "kind", "subject_type", "subject_id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{6}(-[a-f0-9]{8})?$"
    },
    "schema_version": {
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "task.created",
        "task.state_changed",
        "task.blocked",
        "task.claimed",
        "task.dispatched",
        "task.reviewed",
        "run.pending",
        "run.dispatched",
        "run.verifying",
        "run.completed",
        "run.failed",
        "review.started",
        "review.verdict",
        "guard.denied",
        "guard.warned",
        "decision.recorded",
        "context.queried",
        "context.reuse_scanned"
      ]
    },
    "subject_type": {
      "enum": ["task", "run", "review", "decision", "context"]
    },
    "subject_id": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "description": "Source of the event. Free string namespaced by prefix: pmctl|hook|adapter:<name>. NOT an enum (CLI-agnostic invariant)."
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{6}$",
      "description": "Shared key linking this Event to its paired Run row for the same transition."
    },
    "payload": {
      "type": "object",
      "description": "Kind-specific data. Loose-typed by design — kind-specific subschemas can be added per kind without a breaking schema_version bump.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "kind": {
        "enum": [
          "run.pending",
          "run.dispatched",
          "run.verifying",
          "run.completed",
          "run.failed"
        ]
      }
    },
    "required": ["kind"]
  },
  "then": {
    "required": ["payload"],
    "properties": {
      "payload": {
        "required": ["run_id", "state", "from_state", "to_state"],
        "properties": {
          "run_id": {"type": "string"},
          "state": {"type": "string"},
          "from_state": {"type": "string"},
          "to_state": {"type": "string"}
        }
      }
    }
  }
}
