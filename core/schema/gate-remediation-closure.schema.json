{
  "title": "Gate remediation closure",
  "description": "Immutable evidence that a primary Gate finding set was closed, confirmed, or split without claiming a fresh comprehensive review.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "state",
    "scope_manifest_sha256",
    "primary",
    "final_subject",
    "findings",
    "changed_files",
    "affected_tests",
    "targeted_confirmation",
    "unresolved_counts",
    "final_assessment"
  ],
  "properties": {
    "kind": { "const": "remediation_closure_v1" },
    "schema_version": { "const": 1 },
    "state": { "enum": ["closed", "split"] },
    "scope_manifest_sha256": { "$ref": "#/definitions/sha256" },
    "primary": { "$ref": "#/definitions/primaryEvidence" },
    "final_subject": { "$ref": "#/definitions/subject" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "changed_files": { "$ref": "#/definitions/pathSet" },
    "affected_tests": {
      "type": "array",
      "items": { "$ref": "#/definitions/testEvidence" }
    },
    "targeted_confirmation": { "$ref": "#/definitions/targetedConfirmation" },
    "unresolved_counts": { "$ref": "#/definitions/unresolvedCounts" },
    "final_assessment": { "$ref": "#/definitions/finalAssessment" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "pathSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/path" }
    },
    "artifactLink": {
      "type": "object",
      "required": ["artifact", "sha256", "subject_fingerprint"],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "subject_fingerprint": { "$ref": "#/definitions/sha256" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": [
        "repository_key",
        "base_commit",
        "head_commit",
        "tree_fingerprint",
        "subject_kind"
      ],
      "properties": {
        "repository_key": { "$ref": "#/definitions/sha256" },
        "base_commit": { "$ref": "#/definitions/sha1" },
        "head_commit": { "$ref": "#/definitions/sha1" },
        "tree_fingerprint": { "$ref": "#/definitions/sha256" },
        "subject_kind": {
          "enum": ["committed_head", "working_tree", "fixed_ref"]
        }
      },
      "additionalProperties": false
    },
    "primaryEvidence": {
      "type": "object",
      "required": ["gate_result", "verdict", "status", "subject"],
      "properties": {
        "gate_result": { "$ref": "#/definitions/artifactLink" },
        "verdict": { "enum": ["GO", "NO-GO", "INCOMPLETE"] },
        "status": { "enum": ["verified", "unavailable"] },
        "subject": { "$ref": "#/definitions/subject" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/definitions/path" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"], "minLength": 1 }
      },
      "anyOf": [
        {
          "required": ["line"],
          "properties": {
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "origin",
        "disposition",
        "classification",
        "changed_paths",
        "evidence_refs",
        "affected_test_ids",
        "verification_status"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^(critic|qa-tester|architecture-reviewer|security-reviewer|risk-reviewer)-F[0-9]{3,}$"
        },
        "origin": {
          "enum": ["diff_caused", "pre_existing", "uncertain", "caution"]
        },
        "disposition": {
          "enum": ["closed", "tracked", "split"]
        },
        "classification": {
          "enum": ["local", "targeted_confirmation", "stop_split"]
        },
        "changed_paths": { "$ref": "#/definitions/pathSet" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/evidenceRef" }
        },
        "affected_test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_status": {
          "enum": ["pass", "not_required", "split"]
        },
        "ticket_ref": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "testEvidence": {
      "type": "object",
      "required": ["id", "kind", "command", "status", "subject_fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["focused", "full"] },
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "not_run"] },
        "subject_fingerprint": { "$ref": "#/definitions/sha256" },
        "artifact": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "artifact_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "targetedConfirmation": {
      "type": "object",
      "required": ["status", "reviewers", "delta_only"],
      "properties": {
        "status": { "enum": ["pass", "not_required", "incomplete"] },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "delta_only": { "const": true },
        "evidence": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/artifactLink" }
          ]
        }
      },
      "additionalProperties": false
    },
    "unresolvedCounts": {
      "type": "object",
      "required": ["total", "blocking", "advisory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "blocking": { "type": "integer", "minimum": 0 },
        "advisory": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "finalAssessment": {
      "type": "object",
      "required": [
        "remediation_status",
        "affected_tests_status",
        "full_suite_status",
        "subject_fingerprint",
        "publish_authorized"
      ],
      "properties": {
        "remediation_status": { "enum": ["closed", "split"] },
        "affected_tests_status": { "enum": ["pass", "incomplete", "fail"] },
        "full_suite_status": { "enum": ["pass", "not_run", "fail"] },
        "subject_fingerprint": { "$ref": "#/definitions/sha256" },
        "publish_authorized": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
