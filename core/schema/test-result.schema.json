{
  "title": "PM test result",
  "description": "State-bound evidence emitted by the pm-dispatch test runner.",
  "type": "object",
  "required": [
    "kind", "schema_version", "repo_root", "repo_identity", "base_ref", "base_commit",
    "contract", "authoritative",
    "status", "exit_code", "started_at", "finished_at", "tree_fingerprint",
    "observed_tree_fingerprint_after", "runner_contract_hash", "suite_set",
    "selection_mode", "changed_paths", "requested_skips", "suite_results", "aggregate"
  ],
  "properties": {
    "kind": { "const": "pm_test_result_v2" },
    "schema_version": { "const": 2 },
    "repo_root": { "type": "string", "pattern": "^/" },
    "repo_identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "base_ref": { "type": ["string", "null"] },
    "base_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
    "head_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
    "contract": { "enum": ["iteration", "full", "full-with-skips"] },
    "authoritative": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "stale"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "tree_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_tree_fingerprint_after": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runner_contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command_identity": {
      "description": "Optional caller-supplied digest of the exact command whose result this artifact records. Required only by consumers that explicitly bind evidence to a command.",
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "selection_mode": { "enum": ["all", "working-tree", "base-diff", "explicit-paths", "escalated-full"] },
    "changed_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "suite_set": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "requested_skips": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "suite_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "status", "exit_code", "duration_seconds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "timeout", "skip"] },
          "exit_code": { "type": "integer", "minimum": 0 },
          "duration_seconds": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": "object", "required": ["status", "selected", "passed", "failed", "timed_out", "skipped"],
      "properties": {
        "status": { "enum": ["pass", "fail", "stale"] },
        "selected": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "timed_out": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
