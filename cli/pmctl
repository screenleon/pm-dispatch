#!/usr/bin/env bash
# pm-dispatch runtime CLI.
set -euo pipefail

# Resolve the real script path through symlinks so REPO_ROOT is always the
# actual repo directory, regardless of whether pmctl is called via a symlink
# in PATH (e.g. ~/.local/bin/pmctl) or directly.
# Pattern mirrors runtime/bin/pr-gate.sh: loop + rebase relative targets against
# the symlink's own directory, no readlink -f needed (POSIX readlink suffices).
_pmctl_self="${BASH_SOURCE[0]}"
while [[ -L "$_pmctl_self" ]]; do
  _pmctl_dir="$(cd "$(dirname "$_pmctl_self")" && pwd)"
  _pmctl_self="$(readlink "$_pmctl_self")"
  [[ "$_pmctl_self" == /* ]] || _pmctl_self="$_pmctl_dir/$_pmctl_self"
done
REPO_ROOT="$(cd "$(dirname "$_pmctl_self")/.." && pwd)"
unset _pmctl_self _pmctl_dir

PMCTL_COMMAND_REGISTRY="$REPO_ROOT/cli/commands.tsv"
# shellcheck source=runtime/lib/pmctl-command-catalog.sh
. "$REPO_ROOT/runtime/lib/pmctl-command-catalog.sh"

# Command-catalog paths deliberately short-circuit before runtime libraries are
# loaded. Help must be safe even when state, adapters, and external tools are
# unavailable.
if [[ $# -eq 0 ]]; then
  pmctl_command_catalog_root_help
  exit $?
fi
case "$1" in
  -h|--help)
    [[ $# -eq 1 ]] || { pmctl_command_catalog_die 'root help accepts no arguments'; exit 2; }
    pmctl_command_catalog_root_help
    exit $?
    ;;
  help)
    shift
    pmctl_command_catalog_help "$@"
    exit $?
    ;;
esac
# Global help intentionally wins in these fixed command slots. A literal
# option-shaped positional value must be passed in a command-specific data slot.
if [[ $# -eq 2 && ( "$2" == "-h" || "$2" == "--help" ) ]]; then
  pmctl_command_catalog_help "$1"
  exit $?
fi
if [[ $# -eq 3 && ( "$3" == "-h" || "$3" == "--help" ) ]]; then
  pmctl_command_catalog_help "$1" "$2"
  exit $?
fi

for _lib in identifier-policy runner-kind adapter-manifest repo-layout detached-launch pmctl-policy pmctl-fs pmctl-adapter pmctl-backlog pmctl-guard executor-router pmctl-dispatch pmctl-operation pmctl-trace pmctl-task pmctl-decision gate-result-verify gate-publish pmctl-gate pmctl-safe pmctl-validate pmctl-context pmctl-memory pmctl-artifacts pmctl-pre-release pmctl-worktree pmctl-ship-parallel pmctl-ship pmctl-state pmctl-pm; do
  # shellcheck source=/dev/null
  [[ -r "$REPO_ROOT/runtime/lib/$_lib.sh" ]] && . "$REPO_ROOT/runtime/lib/$_lib.sh"
done
unset _lib

pmctl_die() {
  printf 'pmctl: %s\n' "$*" >&2
  exit 2
}

cmd="${1:-}"
shift 2>/dev/null || true
sub="${1:-}"
shift 2>/dev/null || true

case "$cmd/$sub" in
  commands/--json)
    [[ $# -eq 0 ]] || pmctl_die "commands --json accepts no arguments"
    pmctl_command_catalog_commands_json
    ;;
  adapter/generate)
    if ! declare -F pmctl_adapter_generate >/dev/null; then
      pmctl_die "adapter generate unavailable"
    fi
    pmctl_adapter_generate "$@"
    ;;
  backlog/view)
    if ! declare -F pmctl_backlog_view >/dev/null; then
      pmctl_die "backlog view unavailable"
    fi
    pmctl_backlog_view "$REPO_ROOT/BACKLOG.md" "$@"
    ;;
  backlog/lint)
    if ! declare -F pmctl_backlog_lint >/dev/null; then
      pmctl_die "backlog lint unavailable"
    fi
    pmctl_backlog_lint "$REPO_ROOT"
    ;;
  backlog/archive)
    if ! declare -F pmctl_backlog_archive >/dev/null; then
      pmctl_die "backlog archive unavailable"
    fi
    pmctl_backlog_archive "$REPO_ROOT" "$@"
    ;;
  guard/check)
    if ! declare -F pmctl_guard_check >/dev/null; then
      pmctl_die "guard check unavailable"
    fi
    pmctl_guard_check "$REPO_ROOT" "$@"
    ;;
  dispatch/run)
    if ! declare -F pmctl_dispatch_run >/dev/null; then
      pmctl_die "dispatch run unavailable"
    fi
    pmctl_dispatch_run "$REPO_ROOT" "$@"
    ;;
  dispatch/wait)
    if ! declare -F pmctl_dispatch_wait >/dev/null; then
      pmctl_die "dispatch wait unavailable"
    fi
    pmctl_dispatch_wait "$REPO_ROOT" "$@"
    ;;
  dispatch/cancel)
    if ! declare -F pmctl_dispatch_cancel >/dev/null; then
      pmctl_die "dispatch cancel unavailable"
    fi
    pmctl_dispatch_cancel "$REPO_ROOT" "$@"
    ;;
  dispatch/status)
    if ! declare -F pmctl_dispatch_status >/dev/null; then
      pmctl_die "dispatch status unavailable"
    fi
    pmctl_dispatch_status "$REPO_ROOT" "$@"
    ;;
  dispatch/reconcile)
    if ! declare -F pmctl_dispatch_reconcile >/dev/null; then
      pmctl_die "dispatch reconcile unavailable"
    fi
    pmctl_dispatch_reconcile "$REPO_ROOT" "$@"
    ;;
  artifacts/list)
    if ! declare -F pmctl_artifacts_list >/dev/null; then
      pmctl_die "artifacts list unavailable"
    fi
    pmctl_artifacts_list "$REPO_ROOT" "" "$@"
    ;;
  artifacts/show)
    if ! declare -F pmctl_artifacts_show >/dev/null; then
      pmctl_die "artifacts show unavailable"
    fi
    pmctl_artifacts_show "$REPO_ROOT" "" "" "$@"
    ;;
  artifacts/gc)
    if ! declare -F pmctl_artifacts_gc >/dev/null; then
      pmctl_die "artifacts gc unavailable"
    fi
    pmctl_artifacts_gc "$REPO_ROOT" "" "$@"
    ;;
  artifacts/migrate)
    if ! declare -F pmctl_artifacts_migrate >/dev/null; then
      pmctl_die "artifacts migrate unavailable"
    fi
    pmctl_artifacts_migrate "$REPO_ROOT" "" "$@"
    ;;
  state/status)
    if ! declare -F pmctl_state_status >/dev/null; then
      pmctl_die "state status unavailable"
    fi
    pmctl_state_status "$REPO_ROOT" "$@"
    ;;
  worktree/create)
    if ! declare -F pmctl_worktree_create >/dev/null; then
      pmctl_die "worktree create unavailable"
    fi
    pmctl_worktree_create "$REPO_ROOT" "" "$@"
    ;;
  worktree/list)
    if ! declare -F pmctl_worktree_list >/dev/null; then
      pmctl_die "worktree list unavailable"
    fi
    pmctl_worktree_list "$REPO_ROOT" "" "$@"
    ;;
  worktree/remove)
    if ! declare -F pmctl_worktree_remove >/dev/null; then
      pmctl_die "worktree remove unavailable"
    fi
    pmctl_worktree_remove "$REPO_ROOT" "" "$@"
    ;;
  worktree/gc)
    if ! declare -F pmctl_worktree_gc >/dev/null; then
      pmctl_die "worktree gc unavailable"
    fi
    pmctl_worktree_gc "$REPO_ROOT" "" "$@"
    ;;
  ship/prepare)
    if ! declare -F pmctl_ship_prepare >/dev/null; then
      pmctl_die "ship prepare unavailable"
    fi
    _ship_cd="" _ship_ticket=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cd) _ship_cd="${2:-}"; shift 2 ;;
        -*) pmctl_die "ship prepare: unknown option: $1" ;;
        *) _ship_ticket="$1"; shift ;;
      esac
    done
    pmctl_ship_prepare "$REPO_ROOT" "$_ship_cd" "$_ship_ticket"
    ;;
  ship/finish)
    if ! declare -F pmctl_ship_finish >/dev/null; then
      pmctl_die "ship finish unavailable"
    fi
    _ship_cd="" _ship_ticket="" _ship_rest=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cd) _ship_cd="${2:-}"; shift 2 ;;
        --reviewers) _ship_rest+=(--reviewers "${2:-}"); shift 2 ;;
        --gate-result)
          [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || pmctl_die "ship finish: --gate-result requires an artifact path"
          _ship_rest+=(--gate-result "$2"); shift 2 ;;
        --full-result)
          [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || pmctl_die "ship finish: --full-result requires an artifact path"
          _ship_rest+=(--full-result "$2"); shift 2 ;;
        -*) pmctl_die "ship finish: unknown option: $1" ;;
        *) _ship_ticket="$1"; shift ;;
      esac
    done
    pmctl_ship_finish "$REPO_ROOT" "$_ship_cd" "$_ship_ticket" ${_ship_rest[@]+"${_ship_rest[@]}"}
    ;;
  ship/--parallel)
    if ! declare -F pmctl_ship_parallel_run >/dev/null; then
      pmctl_die "ship --parallel unavailable"
    fi
    pmctl_ship_parallel_run "$REPO_ROOT" "" "$@"
    ;;
  ship/status)
    if ! declare -F pmctl_ship_parallel_status >/dev/null; then
      pmctl_die "ship status unavailable"
    fi
    pmctl_ship_parallel_status "$REPO_ROOT" "" "$@"
    ;;
  ship/list)
    if ! declare -F pmctl_ship_parallel_list >/dev/null; then
      pmctl_die "ship list unavailable"
    fi
    pmctl_ship_parallel_list "$REPO_ROOT" "" "$@"
    ;;
  ship/cancel)
    if ! declare -F pmctl_operation_cancel >/dev/null; then
      pmctl_die "ship cancel unavailable"
    fi
    pmctl_operation_cancel "$REPO_ROOT" ship "$@"
    ;;
  ship/reconcile)
    if ! declare -F pmctl_operation_reconcile >/dev/null; then
      pmctl_die "ship reconcile unavailable"
    fi
    pmctl_operation_reconcile "$REPO_ROOT" ship "$@"
    ;;
  ship/*)
    # Fallback for the unified start entry (CC-442/CC-443): `sub` here is
    # whatever followed `ship` and did not match one of the reserved-word
    # cases above (prepare/finish/status/list/--parallel) -- i.e. a
    # ticket-id-shaped token. Reconstruct the full argv (sub was already
    # shifted off) and hand it to pmctl_ship_run, which does its own shape
    # validation and prints the "empty argument" usage error itself.
    if ! declare -F pmctl_ship_run >/dev/null; then
      pmctl_die "ship unavailable"
    fi
    set -- "$sub" "$@"
    _ship_cd="" _ship_ticket="" _ship_rest=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cd) _ship_cd="${2:-}"; shift 2 ;;
        --worktree) _ship_rest+=(--worktree); shift ;;
        --adapter)
          [[ $# -ge 2 && "$2" != -* ]] || pmctl_die "ship: --adapter requires a value"
          _ship_rest+=(--adapter "$2"); shift 2 ;;
        --from)
          [[ $# -ge 2 && "$2" != -* ]] || pmctl_die "ship: --from requires a value"
          _ship_rest+=(--from "$2"); shift 2 ;;
        --isolation)
          [[ $# -ge 2 && "$2" != -* ]] || pmctl_die "ship: --isolation requires a value"
          _ship_rest+=(--isolation "$2"); shift 2 ;;
        --model)
          [[ $# -ge 2 && "$2" != -* ]] || pmctl_die "ship: --model requires a value"
          _ship_rest+=(--model "$2"); shift 2 ;;
        --auto-pack) _ship_rest+=(--auto-pack); shift ;;
        --no-auto-pack) _ship_rest+=(--no-auto-pack); shift ;;
        -h|--help) _ship_rest+=(--help); shift ;;
        -*) pmctl_die "ship: unknown option: $1" ;;
        *)
          [[ -z "$_ship_ticket" ]] || pmctl_die "ship: unexpected extra positional argument: $1 (a ticket id was already given: $_ship_ticket)"
          _ship_ticket="$1"; shift ;;
      esac
    done
    pmctl_ship_run "$REPO_ROOT" "$_ship_cd" "$_ship_ticket" ${_ship_rest[@]+"${_ship_rest[@]}"}
    ;;
  trace/tail)
    if ! declare -F pmctl_trace_tail >/dev/null; then
      pmctl_die "trace tail unavailable"
    fi
    pmctl_trace_tail "$REPO_ROOT" "$@"
    ;;
  task/list)
    if ! declare -F pmctl_task_list >/dev/null; then
      pmctl_die "task list unavailable"
    fi
    pmctl_task_list "$REPO_ROOT" "$@"
    ;;
  task/show)
    if ! declare -F pmctl_task_show >/dev/null; then
      pmctl_die "task show unavailable"
    fi
    pmctl_task_show "$REPO_ROOT" "$@"
    ;;
  task/create)
    if ! declare -F pmctl_task_create >/dev/null; then
      pmctl_die "task create unavailable"
    fi
    pmctl_task_create "$REPO_ROOT" "$@"
    ;;
  task/update)
    if ! declare -F pmctl_task_update >/dev/null; then
      pmctl_die "task update unavailable"
    fi
    pmctl_task_update "$REPO_ROOT" "$@"
    ;;
  task/claim)
    if ! declare -F pmctl_task_claim >/dev/null; then
      pmctl_die "task claim unavailable"
    fi
    pmctl_task_claim "$REPO_ROOT" "$@"
    ;;
  task/dispatch)
    if ! declare -F pmctl_task_dispatch_sub >/dev/null; then
      pmctl_die "task dispatch unavailable"
    fi
    pmctl_task_dispatch_sub "$REPO_ROOT" "$@"
    ;;
  task/status)
    if ! declare -F pmctl_task_status >/dev/null; then
      pmctl_die "task status unavailable"
    fi
    pmctl_task_status "$REPO_ROOT" "$@"
    ;;
  task/review)
    if ! declare -F pmctl_task_review >/dev/null; then
      pmctl_die "task review unavailable"
    fi
    pmctl_task_review "$REPO_ROOT" "$@"
    ;;
  safe/bash)
    if ! declare -F pmctl_safe_bash >/dev/null; then
      pmctl_die "safe bash unavailable"
    fi
    pmctl_safe_bash "$REPO_ROOT" "$@"
    ;;
  validate/brief)
    if ! declare -F pmctl_validate_brief >/dev/null; then
      pmctl_die "validate brief unavailable"
    fi
    pmctl_validate_brief "$REPO_ROOT" "$@"
    ;;
  decision/add)
    if ! declare -F pmctl_decision_add >/dev/null; then
      pmctl_die "decision add unavailable"
    fi
    pmctl_decision_add "$REPO_ROOT" "$@"
    ;;
  gate/run)
    if ! declare -F pmctl_gate_run >/dev/null; then
      pmctl_die "gate run unavailable"
    fi
    pmctl_gate_run "$REPO_ROOT" "$@"
    ;;
  gate/verify)
    if ! declare -F pmctl_gate_verify >/dev/null; then
      pmctl_die "gate verify unavailable"
    fi
    pmctl_gate_verify "$REPO_ROOT" "$@"
    ;;
  gate/wait)
    if ! declare -F pmctl_gate_wait >/dev/null; then
      pmctl_die "gate wait unavailable"
    fi
    pmctl_gate_wait "$REPO_ROOT" "$@"
    ;;
  gate/cancel)
    if ! declare -F pmctl_operation_cancel >/dev/null; then
      pmctl_die "gate cancel unavailable"
    fi
    pmctl_operation_cancel "$REPO_ROOT" gate "$@"
    ;;
  gate/reconcile)
    if ! declare -F pmctl_operation_reconcile >/dev/null; then
      pmctl_die "gate reconcile unavailable"
    fi
    pmctl_operation_reconcile "$REPO_ROOT" gate "$@"
    ;;
  context/index)
    if ! declare -F pmctl_context_index >/dev/null; then
      pmctl_die "context index unavailable"
    fi
    pmctl_context_index "$@"
    ;;
  context/update)
    if ! declare -F pmctl_context_update >/dev/null; then
      pmctl_die "context update unavailable"
    fi
    pmctl_context_update "$@"
    ;;
  context/status)
    if ! declare -F pmctl_context_status >/dev/null; then
      pmctl_die "context status unavailable"
    fi
    pmctl_context_status "$@"
    ;;
  context/query)
    if ! declare -F pmctl_context_query >/dev/null; then
      pmctl_die "context query unavailable"
    fi
    pmctl_context_query "$@"
    ;;
  context/pack)
    if ! declare -F pmctl_context_pack >/dev/null; then
      pmctl_die "context pack unavailable"
    fi
    pmctl_context_pack "$@"
    ;;
  context/reuse-scan)
    if ! declare -F pmctl_context_reuse_scan >/dev/null; then
      pmctl_die "context reuse-scan unavailable"
    fi
    pmctl_context_reuse_scan "$@"
    ;;
  context/prompt-scan)
    if ! declare -F pmctl_context_prompt_scan >/dev/null; then
      pmctl_die "context prompt-scan unavailable"
    fi
    pmctl_context_prompt_scan "$@"
    ;;
  memory/dir)
    if ! declare -F pmctl_memory_dir >/dev/null; then
      pmctl_die "memory dir unavailable"
    fi
    pmctl_memory_dir "$@"
    ;;
  memory/resolve)
    if ! declare -F pmctl_memory_resolve >/dev/null; then
      pmctl_die "memory resolve unavailable"
    fi
    pmctl_memory_resolve "$@"
    ;;
  memory/config)
    if ! declare -F pmctl_memory_config >/dev/null; then
      pmctl_die "memory config unavailable"
    fi
    pmctl_memory_config "$@"
    ;;
  memory/append-episode)
    if ! declare -F pmctl_memory_append_episode >/dev/null; then
      pmctl_die "memory append-episode unavailable"
    fi
    pmctl_memory_append_episode "$@"
    ;;
  memory/doctor)
    if ! declare -F pmctl_memory_doctor >/dev/null; then
      pmctl_die "memory doctor unavailable"
    fi
    pmctl_memory_doctor "$@"
    ;;
  memory/stats)
    if ! declare -F pmctl_memory_stats >/dev/null; then
      pmctl_die "memory stats unavailable"
    fi
    pmctl_memory_stats "$@"
    ;;
  memory/shard)
    if ! declare -F pmctl_memory_shard >/dev/null; then
      pmctl_die "memory shard unavailable"
    fi
    pmctl_memory_shard "$@"
    ;;
  memory/rebuild-summary)
    if ! declare -F pmctl_memory_rebuild_summary >/dev/null; then
      pmctl_die "memory rebuild-summary unavailable"
    fi
    pmctl_memory_rebuild_summary "$@"
    ;;
  pre-release/audit)
    if ! declare -F pmctl_pre_release_audit >/dev/null; then
      pmctl_die "pre-release audit unavailable"
    fi
    pmctl_pre_release_audit "$REPO_ROOT" "$@"
    ;;
  pm/prepare)
    if ! declare -F pmctl_pm_prepare >/dev/null; then
      pmctl_die "pm prepare unavailable"
    fi
    pmctl_pm_prepare "$REPO_ROOT" "$@"
    ;;
  pm/run)
    if ! declare -F pmctl_pm_run >/dev/null; then
      pmctl_die "pm run unavailable"
    fi
    pmctl_pm_run "$REPO_ROOT" "$@"
    ;;
  pm/*)
    pmctl_pm_usage
    pmctl_command_catalog_unknown "pm $sub"
    exit 2
    ;;
  *)
    _unknown="$cmd"
    [[ -z "$sub" ]] || _unknown+=" $sub"
    pmctl_command_catalog_unknown "$_unknown"
    exit 2
    ;;
esac
