#!/usr/bin/env bash
# pm-dispatch runtime CLI.
set -euo pipefail

# Resolve the real script path through symlinks so REPO_ROOT is always the
# actual repo directory, regardless of whether pmctl is called via a symlink
# in PATH (e.g. ~/.local/bin/pmctl) or directly.
# Pattern mirrors scripts/pr-gate.sh: loop + rebase relative targets against
# the symlink's own directory, no readlink -f needed (POSIX readlink suffices).
_pmctl_self="${BASH_SOURCE[0]}"
while [[ -L "$_pmctl_self" ]]; do
  _pmctl_dir="$(cd "$(dirname "$_pmctl_self")" && pwd)"
  _pmctl_self="$(readlink "$_pmctl_self")"
  [[ "$_pmctl_self" == /* ]] || _pmctl_self="$_pmctl_dir/$_pmctl_self"
done
REPO_ROOT="$(cd "$(dirname "$_pmctl_self")/.." && pwd)"
unset _pmctl_self _pmctl_dir

for _lib in pmctl-policy pmctl-fs pmctl-adapter pmctl-backlog pmctl-guard executor-router pmctl-dispatch; do
  # shellcheck source=/dev/null
  [[ -r "$REPO_ROOT/scripts/lib/$_lib.sh" ]] && . "$REPO_ROOT/scripts/lib/$_lib.sh"
done
unset _lib

pmctl_die() {
  printf 'pmctl: %s\n' "$*" >&2
  exit 2
}

cmd="${1:-}"
shift 2>/dev/null || true
sub="${1:-}"
shift 2>/dev/null || true

case "$cmd/$sub" in
  adapter/generate)
    if ! declare -F pmctl_adapter_generate >/dev/null; then
      pmctl_die "adapter generate unavailable"
    fi
    pmctl_adapter_generate "$@"
    ;;
  backlog/view)
    if ! declare -F pmctl_backlog_view >/dev/null; then
      pmctl_die "backlog view unavailable"
    fi
    pmctl_backlog_view "$REPO_ROOT/BACKLOG.md" "$@"
    ;;
  backlog/lint)
    if ! declare -F pmctl_backlog_lint >/dev/null; then
      pmctl_die "backlog lint unavailable"
    fi
    pmctl_backlog_lint "$REPO_ROOT"
    ;;
  backlog/archive)
    if ! declare -F pmctl_backlog_archive >/dev/null; then
      pmctl_die "backlog archive unavailable"
    fi
    pmctl_backlog_archive "$REPO_ROOT" "$@"
    ;;
  guard/check)
    if ! declare -F pmctl_guard_check >/dev/null; then
      pmctl_die "guard check unavailable"
    fi
    pmctl_guard_check "$REPO_ROOT" "$@"
    ;;
  dispatch/run)
    if ! declare -F pmctl_dispatch_run >/dev/null; then
      pmctl_die "dispatch run unavailable"
    fi
    pmctl_dispatch_run "$REPO_ROOT" "$@"
    ;;
  ""/)
    pmctl_die "missing command. Usage: pmctl <cmd> <sub> [args]"
    ;;
  *)
    pmctl_die "unknown command: $cmd $sub"
    ;;
esac
