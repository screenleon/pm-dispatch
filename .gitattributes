# Force LF line endings across all checkouts. Without this, Windows users
# with core.autocrlf=true (Git for Windows default) will see all .sh and
# .md files checked out with CRLF, which breaks bash heredoc parsing,
# shebang interpretation, and diff-heavy tooling.
#
# Specific call-out: hook scripts are interpreted by /bin/bash; a CR at
# the end of the first line breaks shebang resolution silently.

*.sh        text eol=lf
*.bash      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.toml      text eol=lf
*.conf      text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
LICENSE     text eol=lf

# Binary file types that must never be munged.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
